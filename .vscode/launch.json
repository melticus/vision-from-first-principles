{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug webcam",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/webcam",
      "args": [],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.vscode/stream.env",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Debug build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}